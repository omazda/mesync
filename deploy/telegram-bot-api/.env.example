# Скопируйте в .env (рядом с docker-compose.yml) и подставьте свои значения.
# Эти данные получает ВЛАДЕЛЕЦ на https://my.telegram.org → "API development tools"
# (вход личным аккаунтом Telegram, НЕ токеном бота). Создайте приложение — получите
# api_id (число) и api_hash (строка). Это учётные данные ПРИЛОЖЕНИЯ, не бота.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
