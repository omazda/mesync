# Шаблон окружения. Скопируйте в .env; пустые токены оставляют интеграции выключенными.
# Чтобы включить Telegram, укажите токен бота без кавычек.
TELEGRAM_BOT_TOKEN=

# Скачивать ли байты медиафайлов (true) или только метаданные (false)
DOWNLOAD_MEDIA=true
# Таймаут long polling, сек
LONG_POLL_TIMEOUT=30
# Окно ожидания сборки альбома, сек
MEDIA_GROUP_DEBOUNCE=2.0
# Переопределение базового URL Bot API (например, локальный Bot API server)
# TELEGRAM_API_BASE=https://api.telegram.org
#
# === Снятие лимита на размер файлов (локальный Bot API сервер) ===
# Облачный Telegram режет кросс-мессенджерный перенос: скачивание ≤20 МБ, загрузка ≤50 МБ.
# Чтобы ограничивал ТОЛЬКО трафик, поднимите локальный Bot API сервер
# (см. deploy/telegram-bot-api/README.md) и раскомментируйте эти строки:
# TELEGRAM_API_BASE=http://127.0.0.1:8081
# MESYNC_TG_UPLOAD_MAX_BYTES=2097152000   # ~2 ГБ — потолок кросс-мессенджерной передачи в ОБЕ
#                                         # стороны; медиа крупнее НЕ скачивается (сразу текст+ссылка)
# MAX_DOWNLOAD_BYTES=2097152000           # снять лимит скачивания TG→MAX/архива
# Таймаут переноса крупного медиа СНЯТ по умолчанию (None) — крупный файл качается/грузится
# сколько нужно; ограничены только connect/pool. httpx-таймаут read/write — это ИНТЕРВАЛ
# БЕЗДЕЙСТВИЯ (нет данных N сек), а не общий лимит; задайте значение, чтобы обрывать застрявшее
# (без прогресса) соединение и не держать поллер на мёртвом CDN:
# TELEGRAM_MEDIA_TIMEOUT=300              # сек бездействия до обрыва переноса (пусто/0 = снят)
# MAX_MEDIA_TIMEOUT=300                   # то же для стороны MAX
# Каталог для данных рантайма
# DATA_DIR=./data

# Отправлять логи бота в Telegram пользователям, с которыми у него есть чат
LOG_TO_TELEGRAM=true
# Уровень логов для отправки: DEBUG/INFO/WARNING/ERROR
LOG_TO_TELEGRAM_LEVEL=INFO
# Период отправки накопленных строк лога, сек (троттлинг под лимиты Bot API)
LOG_SHIP_INTERVAL=2.0
# Необязательно: ограничить получателей логов конкретными chat_id (через запятую).
# Пусто = все известные приватные чаты бота.
# LOG_CHAT_ALLOWLIST=123456789,987654321

# === Режим приёма апдейтов standalone Telegram entrypoint ===
# polling (по умолчанию) или webhook. Docker `run_app.py` всегда использует polling.
MODE=polling

# --- Настройки webhook (нужны только при MODE=webhook) ---
# Публичный HTTPS-URL, на который Telegram шлёт апдейты (путь сервера берётся отсюда).
# WEBHOOK_URL=https://example.com/tg/<случайный-путь>
# Адрес/порт, который слушает локальный сервер (за обратным прокси — обычно 127.0.0.1).
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443
# Секрет для X-Telegram-Bot-Api-Secret-Token (пусто = сгенерируется и сохранится в data/).
# WEBHOOK_SECRET=
# Прямой TLS на самом боте (если без обратного прокси):
# WEBHOOK_TLS_CERT=/path/fullchain.pem
# WEBHOOK_TLS_KEY=/path/privkey.pem
# Публичный self-signed сертификат для загрузки в Telegram (параметр certificate):
# WEBHOOK_CERTIFICATE=/path/public-cert.pem

# ============================================================
# Сторона MAX (пакет max_sync). Переменные с префиксом MAX_.
# Документация: docs/max/ (база API platform-api.max.ru,
# авторизация заголовком Authorization: <token>).
# ============================================================
# Чтобы включить MAX, укажите токен бота без кавычек.
MAX_BOT_TOKEN=
# Переопределение базового URL Bot API MAX
# MAX_API_BASE=https://platform-api.max.ru
# Общий темп запросов к Bot API MAX. Платформенный лимит около 30 rps; дефолт 25 даёт запас.
# MAX_API_RATE_LIMIT_RPS=25
# Скачивать ли байты медиа (у входящих вложений MAX может быть прямой url)
MAX_DOWNLOAD_MEDIA=false
# Long polling (только dev): timeout 0..90, limit 1..1000
MAX_LONG_POLL_TIMEOUT=90
# Репостить сообщения привязанного чата владельцу в личку (нативной пересылкой)
MAX_MIRROR_TO_OWNER=true
# Каталог данных рантайма MAX (по умолчанию data/max)
# MAX_DATA_DIR=./data/max

# Отправлять логи бота в MAX пользователям, у кого есть диалог с ботом
MAX_LOG_TO_MESSENGER=true
MAX_LOG_LEVEL=INFO
MAX_LOG_SHIP_INTERVAL=2.0
# Пусто = все известные диалоги; иначе список user_id через запятую
# MAX_LOG_CHAT_ALLOWLIST=12345,67890

# === Режим standalone MAX entrypoint: polling | webhook ===
# Docker `run_app.py` всегда использует polling.
MAX_MODE=polling
# Публичный HTTPS-URL вебхука (порт ТОЛЬКО 443, валидный CA-сертификат).
# Путь сервера берётся из этого URL.
# MAX_WEBHOOK_URL=https://example.com/max/<случайный-путь>
# Локальный адрес/порт (за обратным прокси — обычно 127.0.0.1)
MAX_WEBHOOK_HOST=0.0.0.0
MAX_WEBHOOK_PORT=8089
# Секрет для X-Max-Bot-Api-Secret (пусто = сгенерируется в data/max/). ^[a-zA-Z0-9_-]{5,256}$
# MAX_WEBHOOK_SECRET=
# Прямой TLS на самом боте (если без обратного прокси):
# MAX_WEBHOOK_TLS_CERT=/path/fullchain.pem
# MAX_WEBHOOK_TLS_KEY=/path/privkey.pem

# ============================================================
# Mini-app control-API (пакет src/control). Переменные MESYNC_*.
# Токены ботов берутся из переменных выше (TELEGRAM_BOT_TOKEN, MAX_BOT_TOKEN).
# ============================================================
# HTTP-сервер control-API
MESYNC_API_HOST=0.0.0.0
MESYNC_API_PORT=8090
# Публикация порта через Docker Compose. По умолчанию API доступен только на localhost;
# для внешнего reverse proxy укажите адрес нужного host-интерфейса.
MESYNC_DOCKER_BIND=127.0.0.1
MESYNC_DOCKER_PORT=8090
# Необязательно: готовый приватный app-образ вместо локальной сборки. Сначала выполните
# `docker login`, затем используйте `docker compose pull` и `up --no-build`.
# Для воспроизводимого production закрепляйте точный digest, а не mutable `latest`.
# MESYNC_IMAGE=oligovit6/mesync@sha256:6158fa69b8375b6fa922f6955af18484d0fc6d01d9a17505303dcaa36c9c9315
# Необязательно: другой env-файл для изолированного Compose-проекта/стенда.
# MESYNC_ENV_FILE=.env
# PostgreSQL-контейнер создаётся Compose автоматически. Пароль обязателен: сгенерируйте
# `openssl rand -hex 32` и вставьте результат. БД наружу не публикуется.
MESYNC_POSTGRES_DB=mesync
MESYNC_POSTGRES_USER=mesync
MESYNC_POSTGRES_PASSWORD=
# Для PostgreSQL вне Compose можно задать DSN (он имеет приоритет) либо host/port.
# MESYNC_DATABASE_URL=postgresql://mesync:password@127.0.0.1:5432/mesync
# MESYNC_POSTGRES_HOST=127.0.0.1
# MESYNC_POSTGRES_PORT=5432
# Если TELEGRAM_API_BASE указывает на локальный контейнер из deploy/telegram-bot-api,
# подключите MeSync к его Docker-сети через готовый override:
# COMPOSE_FILE=compose.yaml:compose.telegram-api.yaml
# Override также монтирует каталог файлов текущего Telegram-бота read-only. Укажите
# host-путь и gid процесса Bot API, только если они отличаются от стандартных значений:
# TELEGRAM_API_DATA_DIR=/var/lib/telegram-bot-api
# TELEGRAM_API_FILE_GID=101
# Внутренний TELEGRAM_API_LOCAL_FILES_ROOT override задаёт сам; менять его не требуется.
# Единое отображаемое имя продукта/бота в backend и обоих интерфейсах.
MESYNC_BOT_NAME=MeSync
# Публичный URL аватарки бота для web/admin интерфейсов. Оставьте пустым, чтобы использовать
# встроенную `web/src/assets/logo-light.png`. Рекомендуемый файл: квадратный PNG/WebP
# 1024x1024 px, минимум 512x512 px, без важных деталей у краёв (мессенджеры часто кругло
# обрезают аватар). Для готового Docker-образа используйте HTTPS-ссылку. Root-relative
# путь допустим, если файл уже добавлен в `web/public/` перед сборкой образа.
# MESYNC_BOT_AVATAR_URL=
# Публичный адрес текущего развёртывания, без завершающего `/`.
MESYNC_APP_URL=http://localhost:8090
# Ссылки на ботов. Из них автоматически формируются отображаемые @username и диплинки.
# MESYNC_MAX_BOT_URL=https://max.ru/<bot_username>
# MESYNC_TG_BOT_URL=https://t.me/<bot_username>
# Контакты поддержки. Можно заполнить один или оба; пустые способы скрываются в интерфейсе.
# MESYNC_SUPPORT_TG_URL=https://t.me/<support_username>
# MESYNC_SUPPORT_EMAIL=support@example.com
# Посадочная страница обычного браузера. Описание используется также в meta/OG/JSON-LD.
# MESYNC_LANDING_DESCRIPTION="Синхронизация сообщений между MAX и Telegram"
# Чтобы скрыть оффер, задайте обе переменные пустыми.
# MESYNC_LANDING_OFFER_TITLE="7 дней бесплатно"
# MESYNC_LANDING_OFFER_TEXT="Новым пользователям после подключения автопродления."
# Текст показывается только при включённом рекламном счётчике.
# MESYNC_LANDING_ANALYTICS_NOTICE="Находясь на этом сайте, вы соглашаетесь на сбор аналитических данных."
# Публичный числовой ID VK Ads / Счётчика Mail (Top.Mail.Ru). Пусто — скрипт и цели
# полностью отключены. Короткий путь /vk сохраняет click/campaign-параметры и добавляет UTM.
# MESYNC_VK_ADS_PIXEL_ID=1234567
# MESYNC_VK_ADS_UTM_SOURCE=vkads
# MESYNC_VK_ADS_UTM_MEDIUM=cpc
# Реквизиты владельца развёртывания для оферты и политики конфиденциальности.
# В имени укажите полный статус и ФИО/наименование так, как они должны быть опубликованы.
# MESYNC_LEGAL_PROVIDER_NAME_RU="Полное наименование владельца"
# MESYNC_LEGAL_PROVIDER_NAME_EN="Full legal name of the owner"
# MESYNC_LEGAL_TAX_ID=
# MESYNC_LEGAL_REGISTRATION_ID=
# Версии документов участвуют в обязательном повторном акцепте при изменении условий.
MESYNC_LEGAL_TERMS_VERSION=2026-07-08
MESYNC_LEGAL_PRIVACY_VERSION=2026-07-11
# Каталог файлов control-API. При PostgreSQL `control.json` используется только как
# источник автоматического первичного импорта; остальные runtime-файлы остаются здесь.
# MESYNC_DATA_DIR=./data/control
# Секрет подписи JWT-сессий (пусто = сгенерируется в data/control/session_secret)
# MESYNC_SESSION_SECRET=
# Необязательный служебный Telegram-канал для отчётов об ошибках. Пусто = выключен.
# MESYNC_SERVICE_LOG_CHAT_ID=
# MESYNC_SERVICE_LOG_MAX_PER_MINUTE=20
# Пароль браузерной админ-панели. Он обязателен для запуска Docker Compose с pgAdmin.
MESYNC_ADMIN_PASSWORD=
# pgAdmin открывается на /admin/psql/. Email используется только для входа в pgAdmin.
# Оставьте валидный публичный домен: pgAdmin отклоняет localhost и зарезервированные
# example.com/.test адреса ещё до запуска web-сервера.
# Если отдельный пароль не задан, используется MESYNC_ADMIN_PASSWORD.
MESYNC_PGADMIN_EMAIL=admin@mesync.app
# MESYNC_PGADMIN_PASSWORD=
# Необязательный машинный ключ для X-Admin-Key endpoint-ов; браузерная панель его не использует.
# MESYNC_ADMIN_KEY=
# Срок жизни браузерной admin-сессии, сек (по умолчанию 12 часов).
# MESYNC_ADMIN_SESSION_TTL=43200
# Срок жизни сессии, сек (по умолчанию 60 дней)
# MESYNC_SESSION_TTL=5184000
# DEV/ДЕМО: пропускать проверку подписи хоста при входе по контакту (НЕ для prod)
# MESYNC_AUTH_INSECURE=false
# Напоминания пользователям, открывшим MAX-бота по deep link, но не завершившим регистрацию.
# Список задержек в секундах от первого входа в бота; пустая/некорректная переменная = дефолт.
# MESYNC_REGISTRATION_REMINDER_DELAYS=1800,86400
# Период запуска воркера по wall-clock сетке от 00:00: 1800 = 00:00, 00:30, 01:00...
# MESYNC_REGISTRATION_REMINDER_INTERVAL=1800
# MESYNC_REGISTRATION_REMINDER_BATCH=50
# Параметры тарифа (по умолчанию: 10 правил, 0,5 ТБ, 299 ₽/мес;
# пакет 100 ГБ за 100 ₽ расходуется после месячного лимита и не сгорает).
# MESYNC_RULE_LIMIT=10
# MESYNC_PRICE_RUB=299
# MESYNC_TRAFFIC_LIMIT_BYTES=536870912000
# MESYNC_TOPUP_BYTES=107374182400
# MESYNC_TOPUP_PRICE_RUB=100
# MESYNC_TRIAL_DAYS=7
# MESYNC_RENEW_WINDOW_DAYS=5
# MESYNC_RENEW_RETRY_SECONDS=14400
# MESYNC_RENEW_MAX_ATTEMPTS=6
# Ожидание обработки вложения на стороне MAX (видео/аудио/крупные файлы обрабатываются
# асинхронно ПОСЛЕ загрузки; отправка с их token сразу падает attachment.not.ready —
# docs-api POST/uploads «Обработка файлов»). Список растущих пауз (сек) между повторами
# отправки; всего попыток = число пауз + 1. По умолчанию 2,4,8,16,30 (~60 c). Для крупного
# видео можно увеличить бюджет, напр.: MESYNC_MAX_ATTACH_RETRY_DELAYS=2,4,8,16,30,60,60
# MESYNC_MAX_ATTACH_RETRY_DELAYS=2,4,8,16,30
# Реестр сообщений, СОЗДАННЫХ ботом (защита от петли/самосинхронизации): бот не реагирует
# на свои же сообщения по (messenger, chat_id, mid). Персистентный (data/control/sent_index.json),
# переживает рестарты — ловит и поздние пересылки своих сообщений. TTL записи (сек, по умолч.
# 90 дней) и максимум записей (по умолч. 200000).
# MESYNC_SENT_INDEX_TTL=7776000
# MESYNC_SENT_INDEX_MAX=200000
# CORS (через запятую; * — любой origin)
# MESYNC_CORS_ORIGINS=*
# Базовый URL API для фронта (web/): по умолчанию /api (тот же origin)
# VITE_API_BASE=/api

# ============================================================
# ЮKassa. Пустой shopId или secretKey полностью отключает новые платежи и автопродление;
# коды активации при этом продолжают работать. Webhook: <MESYNC_APP_URL>/api/pay/webhook
# ============================================================
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_BASE_URL=https://api.yookassa.ru
# MESYNC_PAY_RETURN_URL=https://example.com/pay-return.html

# ============================================================
# MiniMax и модерация. API key даёт доступ к AI, но безопасные дефолты ниже оставляют
# предотправочный гейт и ссылки на жалобы выключенными. После запуска ими также можно
# управлять в админ-панели без перезапуска.
# ============================================================
# MESYNC_MODERATION_API_KEY=
# MESYNC_MODERATION_BASE_URL=https://api.minimax.io/anthropic
# MESYNC_MODERATION_MODEL=MiniMax-M3
MESYNC_MODERATION_GATE_MODE=off
MESYNC_MODERATION_REPORTS=false
# MESYNC_MODERATION_TIMEOUT=45
# MESYNC_MODERATION_MAX_INPUT=6000
# MESYNC_MODERATION_MAX_TOKENS=512
# MESYNC_MODERATION_QUOTA_COOLDOWN=300

# Яндекс Маркет — автоматическая выдача кодов цифрового DBS-товара.
# Главный выключатель: false отключает webhook и воркер даже при заполненных реквизитах.
# Уже выданные коды по-прежнему можно активировать.
MESYNC_YANDEX_MARKET_ENABLED=true
# API-Key создайте с доступом inventory-and-order-processing. Все четыре обязательные
# переменные должны быть заполнены, иначе интеграция остаётся выключенной.
# MESYNC_YANDEX_MARKET_API_KEY=
# MESYNC_YANDEX_MARKET_BUSINESS_ID=
# MESYNC_YANDEX_MARKET_CAMPAIGN_ID=
# MESYNC_YANDEX_MARKET_SKU=MESYNC-SMART-1M
# Случайная строка не короче 32 символов. URL для кабинета Маркета:
# <MESYNC_APP_URL>/api/yandex-market/notifications/<эта-строка>
# MESYNC_YANDEX_MARKET_WEBHOOK_SECRET=
# Проверка официальных IP-диапазонов Маркета включена по умолчанию; не отключать в production.
# MESYNC_YANDEX_MARKET_ENFORCE_IP=true
# MESYNC_YANDEX_MARKET_TIMEOUT=15
